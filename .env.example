# Copy to .env, chmod 600 .env, then replace BOTH placeholders.
# Generate independently: openssl rand -hex 32
# Use hexadecimal for the PostgreSQL password: it is interpolated into a URL.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX_PASSWORD
API_KEY=REPLACE_WITH_INDEPENDENT_RANDOM_KEY_AT_LEAST_32_CHARACTERS
PUBLIC_VARIANTS=false
CORS_ORIGINS=
WORKER_CONCURRENCY=1
# Limits and other defaults are documented in README.md.
