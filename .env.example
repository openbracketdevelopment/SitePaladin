HOST=127.0.0.1
PORT=3000
DATABASE_URL=sqlite://data/sitepaladin.db
OPERATOR_USERNAME=operator
# Generate a hash with: cargo run -- hash-password
OPERATOR_PASSWORD_HASH=
# Generate with: openssl rand -hex 32
SESSION_SECRET=
COOKIE_SECURE=false
MAX_PAGES=25
MAX_CONCURRENCY=4
MAX_PER_ORIGIN=2
MIN_ORIGIN_DELAY_MS=250
REQUEST_TIMEOUT_SECS=15
MAX_SCAN_DURATION_SECS=600
MAX_RESPONSE_BYTES=2000000
MAX_UNIQUE_LINKS=200
MAX_LINK_OCCURRENCES=10000
MAX_QUERY_VARIANTS_PER_PATH=3
MAX_ROBOTS_ORIGINS=256
MAX_REDIRECTS=5
ALLOWED_PORTS=80,443
ALLOW_LOCAL_FIXTURE=false
